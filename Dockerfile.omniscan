# Multi-stage Dockerfile for OmniScan Mezon Bot
# Located at workspace root for direct access to local mezon-sdk-go dependency.
#
# Build command:
#   docker build -f Dockerfile.omniscan -t omniscan:latest .
#
# Build with version args:
#   docker build -f Dockerfile.omniscan \
#     --build-arg VERSION=1.0.0 \
#     --build-arg GIT_COMMIT=$(git rev-parse --short HEAD) \
#     -t omniscan:latest .

ARG VERSION=1.0.0
ARG GIT_COMMIT=unknown

# Stage 1: Build binary
FROM golang:1.26-alpine AS builder
RUN apk add --no-cache ca-certificates git tzdata

ARG VERSION
ARG GIT_COMMIT

WORKDIR /workspace

# Copy local SDK dependency
COPY mezon-sdk-go /workspace/mezon-sdk-go

# Copy OmniScan source code
COPY omniscan /workspace/omniscan

# Build static CGO-disabled Linux binary
WORKDIR /workspace/omniscan
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath \
    -ldflags="-w -s -X main.version=${VERSION} -X main.gitCommit=${GIT_COMMIT}" \
    -o /workspace/bin/omniscan .

# Stage 2: Minimal runtime image
FROM alpine:3.20
RUN apk add --no-cache ca-certificates tzdata

WORKDIR /app

# Copy binary from builder stage
COPY --from=builder /workspace/bin/omniscan /app/omniscan

# Setup non-root user
RUN adduser -D -u 10001 omniscan && \
    chown -R omniscan:omniscan /app

USER omniscan

ENV APP_ENV=production \
    TZ=Asia/Ho_Chi_Minh

ENTRYPOINT ["/app/omniscan"]
