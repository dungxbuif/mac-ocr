# OmniScan bot — PRODUCTION environment template.
# Copy to .env.prod and fill REAL secrets. Every variable is REQUIRED (the bot
# fails fast on any missing/invalid one — no hidden defaults).
#
# Bring-up checklist:
#   1. PostgreSQL reachable from every bot host (single source of truth).
#   2. Redis reachable from every bot host (cross-replica dedup + SDK L2 cache).
#   3. LLM endpoint reachable (GET /v1/models).
#   4. OCR proxy: https://ocr.dungxbuif.com (+ key below).
#   5. SINGLE_HOST_LOCK=false when running >1 host; PostgreSQL+Redis keep you safe.

# ── Mezon ──
MEZON_BOT_ID=
MEZON_BOT_TOKEN=
MEZON_HOST=gw.mezon.ai
MEZON_PORT=443

# ── OCR proxy (prod) ──
OCR_PROXY_URL=https://ocr.dungxbuif.com
OCR_API_KEY=

# ── Data stores ──
DATABASE_URL=postgres://USER:PASS@PROD_PG_HOST:5432/omniscan?sslmode=require
REDIS_URL=redis://:PASS@PROD_REDIS_HOST:6379/0

# ── LLM (OpenAI-compatible) ──
LLM_BASE_URL=http://PROD_LLM_HOST:1234/v1
LLM_API_KEY=
LLM_MODEL=qwen/qwen3.6-35b-a3b

# ── Per-user quota (seed defaults; admin can override per user in user_configs) ──
DAILY_SCAN_LIMIT=3
DAILY_OCR_LIMIT=999999
SESSION_ASK_LIMIT=3

# ── Operational timeouts & knobs ──
LLM_HEALTH_TIMEOUT=15
OCR_HTTP_TIMEOUT=30
OCR_POLL_INTERVAL=1
OCR_POLL_TIMEOUT=60
OCR_PROCESS_TIMEOUT=90
SCAN_PROCESS_TIMEOUT=120
QA_TIMEOUT=60
MEZON_CLIENT_TIMEOUT=10
MAX_ATTACHMENT_BYTES=104857600
DEDUP_TTL=600
LLM_SCAN_TEMPERATURE=0.2
LLM_QA_TEMPERATURE=0.3
USER_LIMIT_CACHE_TTL=60

# ── Scaling ──
# true  = single host, flock prevents duplicate replies on same host (dev/1-prod)
# false = multi-host horizontal scale; rely on PostgreSQL + Redis for safety
SINGLE_HOST_LOCK=false
