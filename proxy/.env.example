# Copy to .env and adjust. Never commit real secrets.

APP_ENV=development
HTTP_ADDR=:8080

# PostgreSQL (matches ~/dev-env/docker-compose.yml)
DATABASE_URL=postgres://dev:password@localhost:5432/macocr?sslmode=disable

# Redis (matches ~/dev-env/docker-compose.yml; no password)
REDIS_URL=redis://localhost:6379/0

# MinIO/S3-compatible local dev server (s3rver, see ../local-dev/s3)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=macocr-inputs
S3_ACCESS_KEY_ID=S3RVER
S3_SECRET_ACCESS_KEY=S3RVER
S3_FORCE_PATH_STYLE=true

# Public URLs used to build absolute HATEOAS links
PUBLIC_API_BASE_URL=http://localhost:8080
PUBLIC_DOCS_BASE_URL=http://localhost:3000

# Local Native simulator (`cd ../local-dev && npm start`)
NATIVE_BASE_URL=http://localhost:8787
NATIVE_AUTH_SECRET=change-me-in-production

# Encrypts per-document webhook secrets at rest. Use a long random value in production.
NOTIFICATION_ENCRYPTION_KEY=local-notification-key-change-me
RESULT_TTL=168h
INPUT_TTL=168h
NOTIFICATION_TTL=720h
PROCESSING_LEASE=15m
PROCESSING_MAX_ATTEMPTS=3

SHUTDOWN_TIMEOUT=10s
